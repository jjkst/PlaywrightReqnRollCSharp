<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
	<MSTest>
		<Parallelize>
			<Workers>3</Workers>
			<Scope>ClassLevel</Scope>
		</Parallelize>
	</MSTest>
	<TestRunParameters>
